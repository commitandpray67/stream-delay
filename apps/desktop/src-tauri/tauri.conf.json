{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stream-delay",
  "version": "0.3.2",
  "identifier": "dev.stream-delay.app",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Change your stream delay while live",
    "longDescription": "stream-delay sits between OBS and Twitch and lets you add, remove or change your stream delay while you are live, without restarting OBS.",
    "license": "GPL-3.0-or-later",
    "copyright": "stream-delay contributors",
    "homepage": "https://github.com/commitandpray67/stream-delay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/commitandpray67/stream-delay/releases/latest/download/latest.json"
      ]
    }
  }
}
